# Copy to .env (gitignored). Testnet only. Never commit real values.

# Monad testnet
RPC_URL=https://testnet-rpc.monad.xyz
# Optional extra endpoints for round-robin / batching (comma separated)
RPC_URLS=https://rpc.ankr.com/monad_testnet,https://monad-testnet.drpc.org
CHAIN_ID=10143

# Secrets: prefer ~/.blockwise/testnet.json (mode 0600) with {"mnemonic": "..."}; or set here for local use only.
MNEMONIC=

# Fan-out
WORKERS=20
# Set after measuring gasUsed (Monad charges the gas LIMIT). docs/monad-notes.md A2.
GAS_LIMIT=
MAX_FEE_GWEI=400
PRIORITY_FEE_GWEI=2

# Optional shadow judge (leave empty to run the labelled stand-in)
TYPESAFE_AI_API_KEY=
JEV_MODEL_ID=jev-latest

PORT=3000
